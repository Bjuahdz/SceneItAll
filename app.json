{
  "expo": {
    "name": "SceneItAll",
    "slug": "SceneItAll",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/logov2.png",
    "scheme": "movies",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SceneItAll records your spoken take on a film so it can be transcribed into your journal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logov2.png",
        "backgroundColor": "#000000"
      },
      "permissions": [],
      "package": "com.anonymous.SceneItAll"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icons/logov2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/logov2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d100e"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "SceneItAll saves posters and backdrops to your photo library.",
          "photosPermission": "SceneItAll saves posters and backdrops to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
