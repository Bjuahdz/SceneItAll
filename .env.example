# Copy to .env and fill in. NEVER commit .env itself.
# All EXPO_PUBLIC_* values are inlined into the CLIENT BUNDLE at build time —
# a known dev-phase tradeoff (see PROJECT-PLAN.md §Environment).

# ── TMDB — all movie metadata (required) ──────────────────────────────────────
EXPO_PUBLIC_MOVIE_API_KEY=

# ── Appwrite — anonymous trending analytics (required) ────────────────────────
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_COLLECTION_ID=

# ── Phase 3 enrichment: voice → structured memory (optional until set) ────────
# Takes stay queued ('pending') until keys exist; nothing breaks without them.

# ONE-SHOT DEV RESET: set to 1 and launch once to delete ALL takes + audio
# (favorites untouched). Self-disarming via an on-disk marker — it can never run
# twice on the same device. Remove the line after the launch that performs it.
#EXPO_PUBLIC_DEV_WIPE_TAKES=1

# Transcription — CHOSEN PROVIDER: OpenAI whisper-1 (Bryan, 2026-07-16;
# ~$0.006/take). Set EXPO_PUBLIC_OPENAI_API_KEY. The Groq alternative
# (whisper-large-v3-turbo, cheaper/faster) stays wired and WINS if its key
# is also set — leave EXPO_PUBLIC_GROQ_API_KEY empty unless switching.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=

# Entity / topic / summary extraction — Anthropic (Claude).
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-4-8 (chosen for quality; ~$0.02/take).
# Budget alternative: claude-haiku-4-5 (~$0.004/take) — takes remember their model,
# so switching later still allows reprocessing.
EXPO_PUBLIC_ENRICH_MODEL=
# Optional separate model for opinion-arc insights (the one user-facing sentence);
# falls back to EXPO_PUBLIC_ENRICH_MODEL, then the code default.
EXPO_PUBLIC_INSIGHT_MODEL=

# ONE-SHOT 3f REPROCESS: set to 1 and launch once to re-run extraction on all
# transcribed takes (adds spoken ratings + topic stances; keeps transcripts,
# embeddings, insights). Self-disarming marker, same as the wipe.
# EXPO_PUBLIC_DEV_REPROCESS_ENRICH=1
